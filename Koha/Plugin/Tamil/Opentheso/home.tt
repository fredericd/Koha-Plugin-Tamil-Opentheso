[% INCLUDE "$PLUGIN_DIR/head.tt" %]

<style>
.markdown {
  font-size: 100%;
}
.markdown h2 {
  margin-top: 20px;
}
.markdown img {
  width: 100%;
}
</style>

<div class="row">
 <div class="col-md-6 markdown" id="opentheso-home"></div>
</div>
<div class="col-md-6">
</div>

<div id="opentheso-home-source" style="display:none">[% markdown | html %]</div>
<script src="/api/v1/contrib/opentheso/static/marked.min.js"></script>
<script>
$(document).ready(function() {
  var source = $('#opentheso-home-source').text();
  $('#opentheso-home').html(marked.parse(source));
});
</script>

[% INCLUDE "$PLUGIN_DIR/foot.tt" %]
